{
  "name": "@openmemo/daemon",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "description": "本地 daemon（Node.js + TS）：任务队列、硬件探测、下载器、DB。仅监听 127.0.0.1（ADR-003 安全硬要求）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "start": "node dist/main.js",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@openmemo/db": "workspace:*",
    "@openmemo/downloader": "workspace:*",
    "@openmemo/mindmap": "workspace:*",
    "@openmemo/pipeline": "workspace:*",
    "@openmemo/runtime": "workspace:*",
    "@openmemo/shared": "workspace:*",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
