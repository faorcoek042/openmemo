# ADR-001 A 类依赖：需要我们自己编译 / 打补丁 / ABI 与模型格式强耦合需 pin commit。
#
# 规则（R-03 §1.3）：
#   R-A 许可证隔离：GPL/AGPL/source-available 组件不得作为 submodule 进入构建树。
#       —— 下列 5 个全部是 MIT / Apache-2.0，符合。
#   R-B fork-before-patch：需要改代码时先 fork 到我们的 org，改 url 指向 fork，
#       禁止直接修改 vendor/<name>/ 内的文件（`git submodule update` 会静默丢弃）。
#   R-C 一律 pin 到 tag，禁止跟踪分支。升级走 PR + CI 全矩阵重编译。
#
# 初始化：pnpm submodules:init
#   （= git submodule update --init --depth 1 --recommend-shallow）
#
# FFmpeg 不在此列 —— ADR-002 v2 放宽后改用 npm `ffmpeg-static`（GPL-3.0，B 类）。
# 若日后恢复商用意图，需按 R-03 §4.5 把 FFmpeg 源码重新加回本文件并自建 LGPL 构建。

[submodule "vendor/whisper.cpp"]
	path = vendor/whisper.cpp
	url = https://github.com/ggml-org/whisper.cpp.git
	shallow = true
	# MIT | pin v1.9.1 | ASR 主引擎，需自建 CI（ADR-003 决策 2：官方 release 无 macOS/Vulkan/ROCm）

[submodule "vendor/llama.cpp"]
	path = vendor/llama.cpp
	url = https://github.com/ggml-org/llama.cpp.git
	shallow = true
	# MIT | pin b10223 | 本地 LLM 推理（摘要/大纲/思维导图生成）
	# 注：ADR-003 决策 2 说 LLM 线走官方预编译、不自建 CI；此 submodule 用于
	#     版本对齐、GGUF 元数据解析参考与必要时的本地自建，非默认构建路径。

[submodule "vendor/sherpa-onnx"]
	path = vendor/sherpa-onnx
	url = https://github.com/k2-fsa/sherpa-onnx.git
	shallow = true
	# Apache-2.0 | pin v1.13.4 | 副引擎：流式 ASR + VAD + 说话人分离（一个组件覆盖 D3/D4/D5）

[submodule "vendor/sqlite-vec"]
	path = vendor/sqlite-vec
	url = https://github.com/asg017/sqlite-vec.git
	shallow = true
	# Apache-2.0（npm 自报 "MIT OR Apache"）| pin v0.1.9 | SQLite 向量检索扩展
	# ⚠️ 仍是 0.1.x，磁盘格式可能变更 → 向量索引必须设计成可重建

[submodule "vendor/libsimple"]
	path = vendor/libsimple
	url = https://github.com/wangfenjin/simple.git
	shallow = true
	# 双授权 MIT OR GPL-3.0 —— 【本项目选择 MIT】，见 vendor/README.md
	# pin v0.7.1 | SQLite FTS5 中文分词 tokenizer（jieba + 拼音）
