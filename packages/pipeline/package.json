{
  "name": "@openmemo/pipeline",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "description": "媒体导入 → 转写 → 结构化（F1/F2/F3）。原生工具一律子进程调用（ADR-003 决策 1）",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean"
  },
  "dependencies": {
    "@openmemo/downloader": "workspace:*",
    "@openmemo/mindmap": "workspace:*",
    "@openmemo/runtime": "workspace:*",
    "@openmemo/shared": "workspace:*",
    "ffmpeg-static": "^5.3.0",
    "sherpa-onnx-node": "^1.13.4",
    "youtube-dl-exec": "^3.1.9"
  }
}
